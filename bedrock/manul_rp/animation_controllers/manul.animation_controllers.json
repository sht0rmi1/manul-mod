{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.manul.look": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": ["look_at_target"]
				}
			}
		},
		"controller.animation.manul.voice": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": ["voice"]
				}
			}
		},
		"controller.animation.manul.baby": {
			"initial_state": "adult",
			"states": {
				"adult": {
					"transitions": [{ "baby": "q.is_baby" }]
				},
				"baby": {
					"animations": ["baby_head"],
					"transitions": [{ "adult": "!q.is_baby" }]
				}
			}
		},
		"controller.animation.manul.purr": {
			"initial_state": "quiet",
			"states": {
				"quiet": {
					"transitions": [{ "purring": "q.is_sitting && q.is_tamed" }]
				},
				"purring": {
					"animations": ["purr"],
					"transitions": [{ "quiet": "!(q.is_sitting && q.is_tamed)" }]
				}
			}
		},
		"controller.animation.manul.scratch": {
			"initial_state": "quiet",
			"states": {
				"quiet": {
					"blend_transition": 0.25,
					"transitions": [{ "scratched": "q.mark_variant == 3" }]
				},
				"scratched": {
					"animations": ["scratched"],
					"blend_transition": 0.25,
					"transitions": [{ "quiet": "q.mark_variant != 3" }]
				}
			}
		},
		"controller.animation.manul.move": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": ["walk", "idle_tail"],
					"blend_transition": 0.2,
					"transitions": [
						{ "hiss": "q.mark_variant == 1" },
						{ "sit": "q.is_sitting" }
					]
				},
				"sit": {
					"animations": ["sit"],
					"blend_transition": 0.25,
					"transitions": [
						{ "hiss": "q.mark_variant == 1" },
						{ "default": "!q.is_sitting" }
					]
				},
				"hiss": {
					"animations": ["hiss"],
					"blend_transition": 0.2,
					"transitions": [
						{ "sit": "q.mark_variant != 1 && q.is_sitting" },
						{ "default": "q.mark_variant != 1" }
					]
				}
			}
		}
	}
}
