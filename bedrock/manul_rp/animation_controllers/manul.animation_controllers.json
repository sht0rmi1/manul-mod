{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.manul.move": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": ["walk", "idle_tail"],
					"blend_transition": 0.2,
					"transitions": [
						{ "hiss": "q.mark_variant == 1" },
						{ "sit": "q.is_sitting" }
					]
				},
				"sit": {
					"animations": ["sit"],
					"blend_transition": 0.25,
					"transitions": [
						{ "hiss": "q.mark_variant == 1" },
						{ "default": "!q.is_sitting" }
					]
				},
				"hiss": {
					"animations": ["hiss"],
					"blend_transition": 0.2,
					"transitions": [
						{ "sit": "q.mark_variant != 1 && q.is_sitting" },
						{ "default": "q.mark_variant != 1" }
					]
				}
			}
		}
	}
}
