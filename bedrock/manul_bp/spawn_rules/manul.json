						{ "test": "has_biome_tag", "operator": "==", "value": "snowy_slopes" },
						{ "test": "has_biome_tag", "operator": "==", "value": "grove" },
						{ "test": "has_biome_tag", "operator": "==", "value": "meadow" },
						{ "test": "has_biome_tag", "operator": "==", "value": "extreme_hills" },
						{
							"all_of": [
